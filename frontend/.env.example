# Copy to .env (gitignored) and fill in per environment.

VITE_API_BASE_URL=http://localhost:8081

# None of the values below are secret — a smart contract address and network name are
# public information (anyone can look them up on a block explorer). Fill these in after
# deploying the contract (see blockchain/README.md).
VITE_CONTRACT_ADDRESS=
VITE_NETWORK_NAME=Polygon Amoy
VITE_CHAIN_ID_HEX=0x13882
VITE_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
