# Copy this file to .env (which is gitignored) before deploying.

# An RPC endpoint for Polygon Amoy testnet (chain ID 80002) — e.g. your Alchemy or Infura
# Polygon Amoy URL, or the public https://rpc-amoy.polygon.technology.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of a THROWAWAY testnet-only wallet, funded with free Amoy POL from a faucet
# (see blockchain/README.md). Used only by Hardhat, only on your own machine, only to deploy
# the contract once. NEVER put a real/mainnet key here. NEVER commit this file.
DEPLOYER_PRIVATE_KEY=
